---
import BaseLayout from '../layouts/base-layout.astro';
import HtmlPreview from '../components/html-preview.tsx';
---

<BaseLayout title="Dialogs" activeCategory="dialogs">
  <h1 class="text-heading font-bold mb-vsp-lg">Draggable Dialog Patterns</h1>
  <p class="text-body text-muted mb-vsp-xl">3 variations showing drag affordances with strict design tokens.</p>
  <div class="space-y-vsp-xl">
    <section>
      <h2 class="text-subheading font-semibold mb-vsp-sm">1. Dot Handle</h2>
      <HtmlPreview client:visible title="Dot Handle" html={`<div class="dialog">
  <div class="dialog__header">
    <div class="dialog__handle"></div>
    <h2 class="dialog__title">Dialog Title</h2>
  </div>
  <div class="dialog__content">
    <p>Grab the six-dot handle to drag this dialog around the screen.</p>
  </div>
  <div class="dialog__footer">
    <button class="button">Cancel</button>
    <button class="button button--primary">OK</button>
  </div>
</div>`} css={`.dialog {
  background-color: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  max-width: 350px;
  width: 90%;
  margin: var(--space-lg);
}

.dialog__header {
  padding: var(--space-md);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  cursor: move;
  user-select: none;
  transition: background-color 0.2s ease;
}

.dialog__header:hover {
  background-color: var(--bg-subtle);
}

.dialog__handle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  padding: var(--space-xs);
  color: var(--fg-muted);
  font-weight: bold;
  font-size: 10px;
  letter-spacing: 2px;
  flex-shrink: 0;
}

.dialog__handle::before {
  content: '⋮⋮';
}

.dialog__title {
  flex: 1;
  font-size: var(--font-lg);
  font-weight: bold;
  color: var(--fg);
  margin: 0;
}

.dialog__content {
  padding: var(--space-md);
  color: var(--fg);
  line-height: 1.6;
  font-size: var(--font-sm);
}

.dialog__footer {
  padding: var(--space-md);
  border-top: 1px solid var(--border);
  display: flex;
  gap: var(--space-sm);
  justify-content: flex-end;
}

.button {
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background-color: var(--bg);
  color: var(--fg);
  cursor: pointer;
  font-size: var(--font-sm);
  transition: all 0.2s ease;
}

.button:hover {
  background-color: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
}

.button--primary {
  background-color: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
}

.button--primary:hover {
  background-color: var(--accent-hover);
  border-color: var(--accent-hover);
}`} height={280} />
    </section>
    <section>
      <h2 class="text-subheading font-semibold mb-vsp-sm">2. Full Title Bar Drag</h2>
      <HtmlPreview client:visible title="Full Title Bar Drag" html={`<div class="dialog dialog--full-drag">
  <div class="dialog__header">
    <h2 class="dialog__title">Drag the entire title bar</h2>
  </div>
  <div class="dialog__content">
    <p>The entire title bar area acts as a drag handle. Click and drag anywhere in the blue area to move the dialog.</p>
  </div>
  <div class="dialog__footer">
    <button class="button">Cancel</button>
    <button class="button button--primary">OK</button>
  </div>
</div>`} css={`.dialog {
  background-color: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  max-width: 350px;
  width: 90%;
  margin: var(--space-lg);
}

.dialog--full-drag .dialog__header {
  cursor: move;
  user-select: none;
}

.dialog__header {
  padding: var(--space-md);
  border-bottom: 1px solid var(--border);
  background-color: rgba(var(--accent-rgb, 99, 102, 241), 0.05);
  transition: all 0.2s ease;
}

.dialog--full-drag .dialog__header:hover {
  background-color: rgba(var(--accent-rgb, 99, 102, 241), 0.12);
}

.dialog__title {
  font-size: var(--font-lg);
  font-weight: bold;
  color: var(--accent);
  margin: 0;
}

.dialog__content {
  padding: var(--space-md);
  color: var(--fg);
  line-height: 1.6;
  font-size: var(--font-sm);
}

.dialog__footer {
  padding: var(--space-md);
  border-top: 1px solid var(--border);
  display: flex;
  gap: var(--space-sm);
  justify-content: flex-end;
}

.button {
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background-color: var(--bg);
  color: var(--fg);
  cursor: pointer;
  font-size: var(--font-sm);
  transition: all 0.2s ease;
}

.button:hover {
  background-color: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
}

.button--primary {
  background-color: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
}

.button--primary:hover {
  background-color: var(--accent-hover);
  border-color: var(--accent-hover);
}`} height={280} />
    </section>
    <section>
      <h2 class="text-subheading font-semibold mb-vsp-sm">3. Side Handle</h2>
      <HtmlPreview client:visible title="Side Handle" html={`<div class="dialog dialog--side">
  <div class="dialog__handle"></div>
  <div class="dialog__inner">
    <div class="dialog__header">
      <h2 class="dialog__title">Side Handle</h2>
    </div>
    <div class="dialog__content">
      <p>Drag using the colored bar on the left side. This design provides a clear drag affordance separate from content.</p>
    </div>
    <div class="dialog__footer">
      <button class="button">Cancel</button>
      <button class="button button--primary">OK</button>
    </div>
  </div>
</div>`} css={`.dialog {
  background-color: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  max-width: 350px;
  width: 90%;
  margin: var(--space-lg);
  display: flex;
  align-items: stretch;
}

.dialog--side .dialog__handle {
  width: 6px;
  background: linear-gradient(to bottom, var(--accent), var(--accent-hover));
  cursor: move;
  border-radius: var(--radius) 0 0 var(--radius);
  transition: all 0.2s ease;
}

.dialog--side .dialog__handle:hover {
  width: 8px;
  box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.1);
}

.dialog__inner {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dialog__header {
  padding: var(--space-md);
  border-bottom: 1px solid var(--border);
}

.dialog__title {
  font-size: var(--font-lg);
  font-weight: bold;
  color: var(--fg);
  margin: 0;
}

.dialog__content {
  padding: var(--space-md);
  color: var(--fg);
  line-height: 1.6;
  font-size: var(--font-sm);
  flex: 1;
}

.dialog__footer {
  padding: var(--space-md);
  border-top: 1px solid var(--border);
  display: flex;
  gap: var(--space-sm);
  justify-content: flex-end;
}

.button {
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background-color: var(--bg);
  color: var(--fg);
  cursor: pointer;
  font-size: var(--font-sm);
  transition: all 0.2s ease;
}

.button:hover {
  background-color: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
}

.button--primary {
  background-color: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
}

.button--primary:hover {
  background-color: var(--accent-hover);
  border-color: var(--accent-hover);
}`} height={280} />
    </section>
  </div>
</BaseLayout>