{
  "name": "zudo-css-playground",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "// ── Core ─────────────────────────────────": "",
    "predev": "lsof -ti :4321 | xargs kill 2>/dev/null; true",
    "dev": "astro dev",
    "predev:net": "lsof -ti :4321 | xargs kill 2>/dev/null; true",
    "dev:net": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "// ── Doc ──────────────────────────────────": "",
    "doc:dev": "pnpm --dir doc start",
    "doc:build": "pnpm --dir doc build",
    "// ── Quality ─────────────────────────────": "",
    "check": "tsc --noEmit",
    "b4push": "./scripts/run-b4push.sh",
    "// ── Hooks ───────────────────────────────": "",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^4.2.1",
    "astro": "^5.7.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,json,css,md,mdx}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
