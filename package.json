{
  "name": "zudo-css-playground",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "// ── Core ─────────────────────────────────": "",
    "predev": "lsof -ti :4321 | xargs kill 2>/dev/null; true",
    "dev": "astro dev",
    "predev:net": "lsof -ti :4321 | xargs kill 2>/dev/null; true",
    "dev:net": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "// ── Doc ──────────────────────────────────": "",
    "doc:dev": "pnpm --dir doc start",
    "doc:build": "pnpm --dir doc build",
    "// ── Quality ─────────────────────────────": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "b4push": "./scripts/run-b4push.sh",
    "// ── Hooks ───────────────────────────────": "",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/node": "^10.0.3",
    "@astrojs/react": "^5.0.1",
    "@zudo-css-playground/design-system": "workspace:*",
    "astro": "^6.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@evilmartians/lefthook": "^1.11.13",
    "@takazudo/mdx-formatter": "^1.0.3",
    "jsdom": "^29.0.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
